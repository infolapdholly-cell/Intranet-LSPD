<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" href="https://r2.fivemanage.com/XEcvh0aBGRYhLzNNcRsQI/lspdnouveau.png">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LSPD — Véhicules suspects</title>
  <link rel="stylesheet" href="style.css?v=15">
  <style>
    .veh-card {
      background:var(--surface); border:1px solid var(--border); border-radius:8px;
      overflow:hidden; transition:all .15s; animation:fadeIn .2s ease both;
    }
    .veh-card:hover { border-color:var(--gold); box-shadow:0 0 12px rgba(201,168,76,.1); }
    .veh-card.statut-vole    { border-color:rgba(184,48,48,.6); animation:blink-border 2s infinite; }
    .veh-card.statut-recherche { border-color:rgba(214,137,16,.5); }
    .veh-card.statut-suspect   { border-color:rgba(37,137,208,.4); }
    .veh-card.statut-blacklist { border-color:rgba(125,60,152,.5); }
    @keyframes blink-border { 0%,100%{border-color:rgba(184,48,48,.6)} 50%{border-color:rgba(184,48,48,.15)} }
    .veh-photo {
      width:100%; height:130px; background:var(--surface2);
      display:flex; align-items:center; justify-content:center;
      font-size:42px; overflow:hidden; position:relative;
    }
    .veh-photo img { width:100%; height:100%; object-fit:cover; }
    .veh-statut-badge {
      position:absolute; top:8px; right:8px;
      font-family:'JetBrains Mono',monospace; font-size:8px;
      padding:2px 8px; border-radius:2px; font-weight:700;
      letter-spacing:1px; text-transform:uppercase;
    }
    .badge-suspect   { background:rgba(37,137,208,.2);  color:#5bc4f5; border:1px solid rgba(37,137,208,.4); }
    .badge-recherche { background:rgba(214,137,16,.2);  color:#fbbf24; border:1px solid rgba(214,137,16,.4); }
    .badge-vole      { background:rgba(184,48,48,.3);   color:#fff;    border:1px solid var(--danger); }
    .badge-blacklist { background:rgba(125,60,152,.2);  color:#bf7df0; border:1px solid rgba(125,60,152,.4); }
    .veh-body  { padding:12px; }
    .veh-plaque {
      font-family:'JetBrains Mono',monospace; font-size:15px; font-weight:700;
      letter-spacing:3px; color:var(--text); margin-bottom:6px;
      padding:4px 10px; background:rgba(201,168,76,.07);
      border:1px solid rgba(201,168,76,.18); border-radius:4px; display:inline-block;
    }
    .veh-modele { font-size:12px; color:var(--text2); margin-bottom:8px; }
    .veh-meta   { font-family:'JetBrains Mono',monospace; font-size:9px; color:var(--text3); margin-bottom:2px; }
    .veh-meta span { color:var(--text2); }
    .veh-actions { display:flex; gap:6px; padding:10px 12px; border-top:1px solid var(--border); }
    .veh-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); gap:12px; }
  </style>
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="theme-color" content="#05080f">
</head>
<body>
<div class="app-shell">
<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>
<div class="topbar">
  <div class="tb-left">
    <button class="tb-menu-btn" onclick="toggleSidebar()">☰</button>
    <div class="tb-brand">
      <div class="tb-shield"></div>
      <img class="tb-logo" src="https://r2.fivemanage.com/XEcvh0aBGRYhLzNNcRsQI/lspdnouveau.png" alt="LSPD" onerror="this.style.display='none'">
      <div class="tb-title">L.S.P.D</div>
    </div>
    <div class="tb-page">Véhicules suspects</div>
  </div>
  <div class="tb-right">
    <div class="tb-status"><div class="live-dot"></div>En ligne</div>
    <div class="tb-time" id="tbClock">--:--:--</div>
    <div class="tb-user">
      <span class="tb-grade" id="tbGrade">—</span>
      <span class="tb-name" id="tbName">Officier</span>
    </div>
    <button class="btn-out" onclick="logout()">Quitter</button>
  </div>
</div>
<div class="shell">
  <div class="sidebar" id="sidebar"></div>
  <div class="main">

    <div class="page-head">
      <div class="page-head-left">
        <h2>Véhicules suspects</h2>
        <p>// Registre des véhicules sous surveillance — Los Santos</p>
      </div>
      <button class="btn btn-primary" id="btnNew">+ Enregistrer un véhicule</button>
    </div>

    <div class="stats-grid" style="grid-template-columns:repeat(5,1fr)">
      <div class="stat-box blue"><div class="stat-lbl">TOTAL</div><div class="stat-val" id="sTotal">—</div></div>
      <div class="stat-box blue"><div class="stat-lbl">SUSPECTS</div><div class="stat-val" id="sSuspect">—</div></div>
      <div class="stat-box gold"><div class="stat-lbl">RECHERCHÉS</div><div class="stat-val" id="sRecherche">—</div></div>
      <div class="stat-box red"><div class="stat-lbl">VOLÉS</div><div class="stat-val" id="sVole">—</div></div>
      <div class="stat-box" style="border-color:rgba(125,60,152,.3)"><div class="stat-lbl">LISTE NOIRE</div><div class="stat-val" id="sBlacklist" style="color:#bf7df0">—</div></div>
    </div>

    <div class="search-bar">
      <input type="text" id="searchInput" placeholder="Rechercher par plaque, propriétaire, modèle..." oninput="filterVeh()">
      <select id="filterStatut" onchange="filterVeh()">
        <option value="">Tous les statuts</option>
        <option value="Suspect">Suspect</option>
        <option value="Recherché">Recherché</option>
        <option value="Volé">Volé</option>
        <option value="Liste noire">Liste noire</option>
      </select>
    </div>

    <div class="veh-grid" id="vehGrid"></div>
    <div id="vehEmpty" style="display:none" class="empty-state">
      <div class="ei">🚗</div><p>Aucun véhicule enregistré</p>
    </div>

  </div>
</div>
</div>

<!-- MODAL DÉTAIL (lecture seule) -->
<div class="modal-bg" id="modalDetail">
  <div class="modal" style="max-width:560px">
    <div class="modal-head">
      <div class="modal-title" id="detailTitle">FICHE VÉHICULE</div>
      <button class="modal-close" onclick="closeModal('modalDetail')">×</button>
    </div>
    <div class="modal-body" id="detailBody"></div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('modalDetail')">Fermer</button>
      <button id="btnEditFromDetail" class="btn btn-primary" style="display:none" onclick="editFromDetail()">✏️ Modifier</button>
    </div>
  </div>
</div>

<!-- MODAL FORMULAIRE -->
<div class="modal-bg" id="modalVeh">
  <div class="modal" style="max-width:600px">
    <div class="modal-head">
      <div class="modal-title" id="modalVehTitle">ENREGISTRER UN VÉHICULE</div>
      <button class="modal-close" onclick="closeModal('modalVeh')">×</button>
    </div>
    <div class="modal-body">
      <div class="form-grid g2" style="margin-bottom:12px">
        <div class="fg"><label>Plaque d'immatriculation *</label><input id="vPlaque" placeholder="ex: ABC-1234" style="text-transform:uppercase"></div>
        <div class="fg"><label>Statut</label>
          <select id="vStatut">
            <option value="Suspect">🔵 Suspect</option>
            <option value="Recherché">🟡 Recherché</option>
            <option value="Volé">🔴 Volé</option>
            <option value="Liste noire">🟣 Liste noire</option>
          </select>
        </div>
        <div class="fg"><label>Marque / Modèle</label><input id="vModele" placeholder="ex: Übermacht Sentinel"></div>
        <div class="fg"><label>Couleur</label><input id="vCouleur" placeholder="ex: Noir mat"></div>
        <div class="fg"><label>Propriétaire</label><input id="vProprietaire" placeholder="Nom du propriétaire"></div>
        <div class="fg"><label>Date d'enregistrement</label><input type="date" id="vDate"></div>
      </div>
      <div class="fg" style="margin-bottom:12px">
        <label>Photo du véhicule (URL)</label>
        <input id="vPhoto" placeholder="https://...">
      </div>
      <div class="fg">
        <label>Raison / Notes</label>
        <textarea id="vNotes" placeholder="Raison de la surveillance, historique des incidents..."></textarea>
      </div>
    </div>
    <div class="modal-footer">
      <button id="btnDeleteVeh" style="display:none;margin-right:auto" class="btn btn-danger btn-sm" onclick="deleteVeh()">🗑 Supprimer</button>
      <button class="btn btn-ghost" onclick="closeModal('modalVeh')">Annuler</button>
      <button class="btn btn-primary" onclick="saveVeh()">Enregistrer</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
  import { getAuth, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";
  import { getFirestore, collection, addDoc, getDocs, doc, updateDoc, deleteDoc } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";
  import { initPage, startClock, showToast, openModal, closeModal, setupModalClose, addLog } from './utils2.js';

  const FC = {
    apiKey:"AIzaSyA4GxYd32GNs5EDjjm2UI1a0d25YxigMVU",
    authDomain:"lspd-intranet-2aed9.firebaseapp.com",
    projectId:"lspd-intranet-2aed9",
    storageBucket:"lspd-intranet-2aed9.firebasestorage.app",
    messagingSenderId:"780922925382",
    appId:"1:780922925382:web:a32d5e89bcff75bd8b3547"
  };

  const WEBHOOK = 'https://discord.com/api/webhooks/1486477450970927144/rmKQTwsO_3WDjp-mYyksN-32TURxiYWvWJoN0KZIU-UhUKf1x95p_37FewUAd_dnsjfL';

  const app = initializeApp(FC);
  const auth = getAuth(app);
  const db   = getFirestore(app);

  let allVeh = [], editingId = null, viewingId = null, userPerms = {}, userName = '';

  startClock('tbClock');
  setupModalClose();
  window.closeModal = closeModal;
  window.openModal  = openModal;

  initPage(auth, db, onAuthStateChanged, 'vehicules-suspects').then(async ({ grade, name, perms }) => {
    userPerms = perms; userName = name;

    if (perms.canWrite) {
      document.getElementById('btnNew').addEventListener('click', () => {
        editingId = null;
        resetForm();
        document.getElementById('modalVehTitle').textContent = 'ENREGISTRER UN VÉHICULE';
        document.getElementById('btnDeleteVeh').style.display = 'none';
        document.getElementById('vDate').value = new Date().toISOString().split('T')[0];
        openModal('modalVeh');
      });
    } else {
      document.getElementById('btnNew').style.display = 'none';
    }
    await loadVeh();
  });

  async function loadVeh() {
    try {
      const snap = await getDocs(collection(db, 'vehicules-suspects'));
      allVeh = snap.docs.map(d => ({ id: d.id, ...d.data() }))
        .sort((a,b) => (b.createdAt||'').localeCompare(a.createdAt||''));
      updateStats();
      renderVeh(allVeh);
    } catch(e) { console.error(e); }
  }

  function updateStats() {
    document.getElementById('sTotal').textContent     = allVeh.length;
    document.getElementById('sSuspect').textContent   = allVeh.filter(v => v.statut === 'Suspect').length;
    document.getElementById('sRecherche').textContent = allVeh.filter(v => v.statut === 'Recherché').length;
    document.getElementById('sVole').textContent      = allVeh.filter(v => v.statut === 'Volé').length;
    document.getElementById('sBlacklist').textContent = allVeh.filter(v => v.statut === 'Liste noire').length;
  }

  const STATUT_CLASS = { 'Suspect':'suspect', 'Recherché':'recherche', 'Volé':'vole', 'Liste noire':'blacklist' };
  const BADGE_CLASS  = { 'Suspect':'badge-suspect', 'Recherché':'badge-recherche', 'Volé':'badge-vole', 'Liste noire':'badge-blacklist' };
  const STATUT_EMOJI = { 'Suspect':'🔵', 'Recherché':'🟡', 'Volé':'🔴', 'Liste noire':'🟣' };

  function renderVeh(list) {
    const grid  = document.getElementById('vehGrid');
    const empty = document.getElementById('vehEmpty');
    if (!list.length) { grid.innerHTML = ''; empty.style.display = 'flex'; return; }
    empty.style.display = 'none';

    grid.innerHTML = list.map(v => `
      <div class="veh-card statut-${STATUT_CLASS[v.statut]||'suspect'}">
        <div class="veh-photo">
          ${v.photoUrl ? `<img src="${v.photoUrl}" onerror="this.parentNode.innerHTML='🚗'">` : '🚗'}
          <span class="veh-statut-badge ${BADGE_CLASS[v.statut]||'badge-suspect'}">${v.statut||'—'}</span>
        </div>
        <div class="veh-body">
          <div class="veh-plaque">${v.plaque||'—'}</div>
          <div class="veh-modele">${[v.modele, v.couleur].filter(Boolean).join(' — ')||'—'}</div>
          <div class="veh-meta">Propriétaire : <span>${v.proprietaire||'—'}</span></div>
          <div class="veh-meta">Officier : <span>${v.officier||'—'}</span></div>
          ${v.date ? `<div class="veh-meta">Date : <span>${new Date(v.date).toLocaleDateString('fr-FR')}</span></div>` : ''}
        </div>
        <div class="veh-actions">
          <button onclick="viewVeh('${v.id}')" style="flex:1;padding:6px;background:rgba(201,168,76,.08);border:1px solid rgba(201,168,76,.2);border-radius:4px;color:var(--gold);font-size:11px;font-weight:600;cursor:pointer">👁 Voir</button>
          ${userPerms.canWrite ? `<button onclick="editVeh('${v.id}')" style="padding:6px 10px;background:rgba(61,88,120,.15);border:1px solid rgba(61,88,120,.3);border-radius:4px;color:var(--text2);font-size:13px;cursor:pointer">✏️</button>` : ''}
        </div>
      </div>`).join('');
  }

  window.filterVeh = function() {
    const q = document.getElementById('searchInput').value.toLowerCase();
    const s = document.getElementById('filterStatut').value;
    renderVeh(allVeh.filter(v =>
      (v.plaque+' '+v.modele+' '+v.proprietaire+' '+v.couleur).toLowerCase().includes(q) &&
      (!s || v.statut === s)
    ));
  };

  window.viewVeh = function(id) {
    const v = allVeh.find(x => x.id === id);
    if (!v) return;
    viewingId = id;

    const colors = {
      'Suspect':    { bg:'rgba(37,137,208,.12)',  c:'#5bc4f5',  b:'rgba(37,137,208,.3)' },
      'Recherché':  { bg:'rgba(214,137,16,.12)',  c:'#fbbf24',  b:'rgba(214,137,16,.3)' },
      'Volé':       { bg:'rgba(184,48,48,.25)',   c:'#fff',     b:'rgba(184,48,48,.5)' },
      'Liste noire':{ bg:'rgba(125,60,152,.15)',  c:'#bf7df0',  b:'rgba(125,60,152,.4)' }
    };
    const sc = colors[v.statut] || colors['Suspect'];

    document.getElementById('detailTitle').textContent = v.plaque || 'VÉHICULE';
    document.getElementById('btnEditFromDetail').style.display = userPerms.canWrite ? 'inline-flex' : 'none';

    document.getElementById('detailBody').innerHTML = `
      <div style="display:flex;gap:16px;align-items:flex-start;margin-bottom:18px">
        <div style="width:150px;height:110px;background:var(--surface2);border:1px solid var(--border);border-radius:6px;overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:36px">
          ${v.photoUrl ? `<img src="${v.photoUrl}" style="width:100%;height:100%;object-fit:cover" onerror="this.parentNode.innerHTML='🚗'">` : '🚗'}
        </div>
        <div style="flex:1">
          <div style="font-family:JetBrains Mono,monospace;font-size:18px;font-weight:700;letter-spacing:3px;margin-bottom:6px;color:var(--text)">${v.plaque||'—'}</div>
          <div style="font-size:13px;color:var(--text2);margin-bottom:10px">${[v.modele,v.couleur].filter(Boolean).join(' — ')||'—'}</div>
          <span style="font-family:JetBrains Mono,monospace;font-size:9px;padding:3px 10px;border-radius:3px;font-weight:700;letter-spacing:1px;text-transform:uppercase;background:${sc.bg};color:${sc.c};border:1px solid ${sc.b}">${STATUT_EMOJI[v.statut]||''} ${v.statut||'—'}</span>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px">
        <div><div style="font-family:JetBrains Mono,monospace;font-size:8px;color:var(--gold);opacity:.6;letter-spacing:2px;text-transform:uppercase;margin-bottom:3px">Propriétaire</div><div style="font-size:13px;font-weight:600">${v.proprietaire||'—'}</div></div>
        <div><div style="font-family:JetBrains Mono,monospace;font-size:8px;color:var(--gold);opacity:.6;letter-spacing:2px;text-transform:uppercase;margin-bottom:3px">Officier</div><div style="font-size:13px">${v.officier||'—'}</div></div>
        <div><div style="font-family:JetBrains Mono,monospace;font-size:8px;color:var(--gold);opacity:.6;letter-spacing:2px;text-transform:uppercase;margin-bottom:3px">Date</div><div style="font-family:JetBrains Mono,monospace;font-size:12px">${v.date ? new Date(v.date).toLocaleDateString('fr-FR') : '—'}</div></div>
        <div><div style="font-family:JetBrains Mono,monospace;font-size:8px;color:var(--gold);opacity:.6;letter-spacing:2px;text-transform:uppercase;margin-bottom:3px">Modèle</div><div style="font-size:12px">${v.modele||'—'}</div></div>
      </div>
      ${v.notes ? `<div><div style="font-family:JetBrains Mono,monospace;font-size:8px;color:var(--gold);opacity:.6;letter-spacing:2px;text-transform:uppercase;margin-bottom:6px">Raison / Notes</div><div style="font-size:13px;padding:10px 12px;background:var(--surface2);border:1px solid var(--border);border-radius:5px;line-height:1.6">${v.notes}</div></div>` : ''}
    `;
    openModal('modalDetail');
  };

  window.editFromDetail = function() {
    closeModal('modalDetail');
    if (viewingId) editVeh(viewingId);
  };

  window.editVeh = function(id) {
    const v = allVeh.find(x => x.id === id);
    if (!v) return;
    editingId = id;
    document.getElementById('modalVehTitle').textContent = 'MODIFIER LE VÉHICULE';
    document.getElementById('btnDeleteVeh').style.display = userPerms.canDelete ? 'inline-flex' : 'none';
    document.getElementById('vPlaque').value      = v.plaque      || '';
    document.getElementById('vStatut').value      = v.statut      || 'Suspect';
    document.getElementById('vModele').value      = v.modele      || '';
    document.getElementById('vCouleur').value     = v.couleur     || '';
    document.getElementById('vProprietaire').value= v.proprietaire|| '';
    document.getElementById('vDate').value        = v.date        || '';
    document.getElementById('vPhoto').value       = v.photoUrl    || '';
    document.getElementById('vNotes').value       = v.notes       || '';
    openModal('modalVeh');
  };

  window.saveVeh = async function() {
    const plaque = document.getElementById('vPlaque').value.trim().toUpperCase();
    if (!plaque) { showToast('La plaque est obligatoire', 'error'); return; }

    const payload = {
      plaque,
      statut:      document.getElementById('vStatut').value,
      modele:      document.getElementById('vModele').value.trim(),
      couleur:     document.getElementById('vCouleur').value.trim(),
      proprietaire:document.getElementById('vProprietaire').value.trim(),
      date:        document.getElementById('vDate').value,
      photoUrl:    document.getElementById('vPhoto').value.trim(),
      notes:       document.getElementById('vNotes').value.trim(),
      officier:    userName,
      updatedAt:   new Date().toISOString()
    };

    try {
      if (editingId) {
        const ancien = allVeh.find(x => x.id === editingId);
        await updateDoc(doc(db, 'vehicules-suspects', editingId), payload);
        await addLog(db, 'Véhicule modifié', `${plaque} — ${payload.statut}`);
        // Alert Discord si passage à Volé
        if (payload.statut === 'Volé' && ancien?.statut !== 'Volé') {
          await sendDiscordAlert(payload, ancien?.statut || '');
        }
        showToast('Véhicule mis à jour ✓', 'success');
      } else {
        payload.createdAt = new Date().toISOString();
        await addDoc(collection(db, 'vehicules-suspects'), payload);
        await addLog(db, 'Véhicule enregistré', `${plaque} — ${payload.statut}`);
        await sendDiscordNew(payload);
        showToast('Véhicule enregistré ✓', 'success');
      }
      closeModal('modalVeh');
      editingId = null;
      await loadVeh();
    } catch(e) { showToast('Erreur : ' + e.message, 'error'); }
  };

  window.deleteVeh = async function() {
    if (!editingId || !confirm('Supprimer ce véhicule du registre ?')) return;
    const v = allVeh.find(x => x.id === editingId);
    try {
      await deleteDoc(doc(db, 'vehicules-suspects', editingId));
      await addLog(db, 'Véhicule supprimé', v?.plaque || '');
      showToast('Véhicule supprimé', 'success');
      closeModal('modalVeh');
      editingId = null;
      await loadVeh();
    } catch(e) { showToast('Erreur : ' + e.message, 'error'); }
  };

  async function sendDiscordNew(v) {
    const colors = { 'Suspect':3447003, 'Recherché':16705372, 'Volé':15158332, 'Liste noire':10181046 };
    try {
      await fetch(WEBHOOK, {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ embeds:[{
          title: STATUT_EMOJI[v.statut] + ' Nouveau véhicule enregistré',
          color: colors[v.statut]||3447003,
          fields:[
            { name:'🚗 Plaque',       value:'`'+v.plaque+'`',           inline:true },
            { name:'📋 Modèle',       value:v.modele||'—',              inline:true },
            { name:'🎨 Couleur',      value:v.couleur||'—',             inline:true },
            { name:'👤 Propriétaire', value:v.proprietaire||'—',        inline:true },
            { name:'📊 Statut',       value:v.statut||'—',              inline:true },
            { name:'👮 Officier',     value:v.officier||'—',            inline:true },
          ],
          footer:{ text:'LSPD Intranet — Véhicules suspects' },
          timestamp: new Date().toISOString()
        }]})
      });
    } catch(e) { console.warn('Discord:', e); }
  }

  async function sendDiscordAlert(v, ancienStatut) {
    try {
      await fetch(WEBHOOK, {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ content:'@everyone', embeds:[{
          title: '🚨 AVERTISSEMENT — VÉHICULE VOLÉ',
